# API Port
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/qa-track-test-management"

# JWT Secret for Authentication
JWT_SECRET="your-super-secret-jwt-key"

# (Optional) Telegram Notification Fallbacks 
# Note: It's recommended to configure Telegram via the Web UI Settings instead.
QA_NOTIF_BOT=true
QA_NOTIF_TOKEN=your-bot-token-here
QA_CHAT_ID=your-chat-id-here
